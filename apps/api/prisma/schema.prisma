// --- Enums ---

enum ProjectStatus {
  not_started
  in_progress
  completed
  cancelled
}

enum ProjectMemberRole {
  admin
  member
}

enum ProjectMemberStatus {
  active
  withdrawn
  removed
}

// --- Models ---

model Project {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String        @db.VarChar(200)
  description       String?       @db.Text
  coverImageUrl     String?       @map("cover_image_url") @db.VarChar(500)
  categoryId        String?       @map("category_id") @db.Uuid
  eventId           String?       @map("event_id") @db.Uuid
  startDate         DateTime?     @map("start_date") @db.Date
  endDate           DateTime?     @map("end_date") @db.Date
  status            ProjectStatus @default(not_started)
  publishStatus     PublishStatus @default(draft) @map("publish_status")
  inviteToken       String        @unique @map("invite_token") @db.VarChar(100)
  inviteLinkEnabled Boolean       @default(false) @map("invite_link_enabled")
  memberCount       Int           @default(0) @map("member_count")
  activityCount     Int           @default(0) @map("activity_count")
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz()

  // Relations
  createdByUser   User                   @relation("ProjectCreator", fields: [createdByUserId], references: [id])
  category        Category?              @relation(fields: [categoryId], references: [id])
  event           Event?                 @relation(fields: [eventId], references: [id])
  members         ProjectMember[]
  threads         ProjectThread[]
  tags            ProjectTag[]
  files           ProjectFile[]
  tasks           ProjectTask[]
  schedules       ProjectSchedule[]
  boardCategories ProjectBoardCategory[]
  boardTopics     ProjectBoardTopic[]

  @@index([publishStatus, status])
  @@index([createdByUserId])
  @@index([eventId])
  @@index([categoryId])
  @@map("projects")
}

model ProjectMember {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
