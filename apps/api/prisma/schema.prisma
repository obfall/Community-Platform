generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Phase 1: 認証・コアシェル
// ============================================================

// --- Enums ---

enum UserRole {
  admin
  owner
  member
  visitor
}

enum UserStatus {
  active
  suspended
  withdrawn
}

enum SocialProvider {
  google
  apple
}

enum LoginStatus {
  success
  failure
}

enum FeatureCategory {
  common
  optional
}

enum SettingValueType {
  string
  integer
  boolean
  json
}

enum FileCategory {
  avatar
  image
  video
  document
  general
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum LanguageProficiency {
  beginner
  intermediate
  advanced
  native
}

enum PublicStatus {
  public
  private
}

// --- Models ---

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  name            String     @db.VarChar(100)
  role            UserRole   @default(member)
  status          UserStatus @default(active)
  rankId          String?    @map("rank_id") @db.Uuid
  availablePoints Int        @default(0) @map("available_points")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz()
  isAdmin         Boolean    @default(false) @map("is_admin")
  isActive        Boolean    @default(true) @map("is_active")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz()
  joinedAt        DateTime?  @map("joined_at") @db.Timestamptz()
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz()

  // Relations
  rank                          MemberRank?                    @relation(fields: [rankId], references: [id])
  socialAccounts                SocialAccount[]
  loginHistories                LoginHistory[]
  refreshTokens                 RefreshToken[]
  passwordResetTokens           PasswordResetToken[]
  profile                       UserProfile?
  interests                     UserInterest[]
  languages                     UserLanguage[]
  affiliations                  UserAffiliation[]
  publicInfo                    UserPublicInfo?
  files                         File[]
  updatedFeatureSettings        FeatureSetting[]               @relation("FeatureUpdatedBy")
  updatedAppSettings            AppSetting[]                   @relation("AppSettingUpdatedBy")
  // Phase 2
  notifications                 Notification[]                 @relation("NotificationRecipient")
  actedNotifications            Notification[]                 @relation("NotificationActor")
  notificationPreferences       NotificationPreference[]
  boardCategories               BoardCategory[]
  boardLikes                    BoardLike[]
  boardTopics                   BoardTopic[]
  boardTopicPosts               BoardTopicPost[]
  boardTopicPostComments        BoardTopicPostComment[]
  // Phase 3
  createdChatRooms              ChatRoom[]                     @relation("ChatRoomCreator")
  chatRoomMemberships           ChatRoomMember[]
  chatMessages                  ChatMessage[]                  @relation("ChatMessageSender")
  createdBroadcasts             Broadcast[]                    @relation("BroadcastCreator")
  broadcastRecipients           BroadcastRecipient[]           @relation("BroadcastRecipientUser")
  // Phase 4
  attributeValues               MemberAttributeValue[]
  // Phase 5
  createdEvents                 Event[]                        @relation("EventCreator")
  eventParticipations           EventParticipant[]
  eventSpeakerProfiles          EventSpeaker[]
  eventBoardCategories          EventBoardCategory[]
  eventBoardTopics              EventBoardTopic[]
  eventBoardTopicPosts          EventBoardTopicPost[]
  eventBoardTopicPostComments   EventBoardTopicPostComment[]
  eventBoardLikes               EventBoardLike[]
  eventFiles                    EventFile[]
  eventResults                  EventResult[]
  // Phase 6
  createdProjects               Project[]                      @relation("ProjectCreator")
  projectMemberships            ProjectMember[]
  projectThreads                ProjectThread[]
  projectThreadReplies          ProjectThreadReply[]
  projectThreadLikes            ProjectThreadLike[]
  projectFiles                  ProjectFile[]
  projectTasks                  ProjectTask[]
  projectTaskAssignees          ProjectTaskAssignee[]
  projectSchedules              ProjectSchedule[]
  projectBoardCategories        ProjectBoardCategory[]
  projectBoardTopics            ProjectBoardTopic[]
  projectBoardTopicPosts        ProjectBoardTopicPost[]
  projectBoardTopicPostComments ProjectBoardTopicPostComment[]
  projectBoardLikes             ProjectBoardLike[]
  // Phase 7
  createdVideos                 Video[]                        @relation("VideoCreator")
  videoInstructorProfiles       VideoInstructor[]
  videoWatchProgress            VideoWatchProgress[]
  videoTaskCompletions          VideoTaskCompletion[]
  activityLogs                  ActivityLog[]
  engagementScore               EngagementScore?
  activitySummary               MemberActivitySummary?
  // Phase 8
  pointSummary                  PointSummary?
  pointHistories                PointHistory[]                 @relation("PointGrantee")
  pointHistoriesGranted         PointHistory[]                 @relation("PointGranter")
  surveysCreated                Survey[]                       @relation("SurveyCreator")
  surveyResponses               SurveyResponse[]               @relation("SurveyRespondent")
  skillListings                 SkillListing[]                 @relation("SkillProvider")
  skillBookingsRequested        SkillBooking[]                 @relation("SkillRequester")
  skillBookingsProviding        SkillBooking[]                 @relation("SkillBookingProvider")
  skillMessages                 SkillMessage[]                 @relation("SkillMessageSender")
  skillComments                 SkillComment[]                 @relation("SkillCommentAuthor")
  // Phase 9
  products                      Product[]                      @relation("ProductSeller")
  ordersBought                  Order[]                        @relation("OrderBuyer")
  ordersSold                    Order[]                        @relation("OrderSeller")
  albumsCreated                 Album[]                        @relation("AlbumCreator")
  albumPhotos                   AlbumPhoto[]                   @relation("AlbumPhotoUploader")
  venuesCreated                 Venue[]                        @relation("VenueCreator")
  reservations                  Reservation[]
  contentsCreated               Content[]                      @relation("ContentCreator")
  shopSettingsUpdated           ShopSetting[]                  @relation("ShopSettingUpdatedBy")
  // Phase 10
  memoCategories                MemoCategory[]
  memos                         Memo[]
  schedules                     Schedule[]
  contentReports                ContentReport[]                @relation("ReportReporter")
  assignedReports               ContentReport[]                @relation("ReportAssignee")
  moderationActions             ModerationAction[]             @relation("ModerationActor")
  orientationCompletion         OrientationCompletion?
  libraryItems                  UserLibraryItem[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model SocialAccount {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  provider       SocialProvider
  providerUserId String         @map("provider_user_id") @db.VarChar(255)
  accessToken    String?        @map("access_token") @db.Text
  refreshToken   String?        @map("refresh_token") @db.Text
  tokenExpiresAt DateTime?      @map("token_expires_at") @db.Timestamptz()
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model LoginHistory {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  userAgent     String?     @map("user_agent") @db.Text
  status        LoginStatus
  failureReason String?     @map("failure_reason") @db.VarChar(50)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("login_histories")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  deviceInfo String?   @map("device_info") @db.VarChar(255)
  ipAddress  String?   @map("ip_address") @db.Inet
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model FeatureSetting {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureKey      String          @unique @map("feature_key") @db.VarChar(50)
  featureName     String          @map("feature_name") @db.VarChar(100)
  category        FeatureCategory
  isAvailable     Boolean         @default(true) @map("is_available")
  isEnabled       Boolean         @default(true) @map("is_enabled")
  description     String?         @db.Text
  sortOrder       Int             @default(0) @map("sort_order")
  enabledAt       DateTime?       @map("enabled_at") @db.Timestamptz()
  disabledAt      DateTime?       @map("disabled_at") @db.Timestamptz()
  updatedByUserId String?         @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  updatedByUser      User?               @relation("FeatureUpdatedBy", fields: [updatedByUserId], references: [id])
  permissionSettings PermissionSetting[]

  @@index([category])
  @@index([isEnabled])
  @@map("feature_settings")
}

model MemberRank {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(50)
  slug      String   @unique @db.VarChar(50)
  color     String?  @db.VarChar(7)
  sortOrder Int      @default(0) @map("sort_order")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  users              User[]
  permissionSettings PermissionSetting[]
  categories         Category[]
  // Phase 5
  events             Event[]
  // Phase 7
  videos             Video[]

  @@index([sortOrder])
  @@map("member_ranks")
}

model PermissionSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureKey     String   @map("feature_key") @db.VarChar(50)
  action         String   @db.VarChar(50)
  allowedRoles   Json     @default("[\"owner\",\"admin\"]") @map("allowed_roles") @db.JsonB
  requiredRankId String?  @map("required_rank_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  featureSetting FeatureSetting @relation(fields: [featureKey], references: [featureKey], onDelete: Cascade)
  requiredRank   MemberRank?    @relation(fields: [requiredRankId], references: [id])

  @@unique([featureKey, action])
  @@index([featureKey])
  @@map("permission_settings")
}

model AppSetting {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String           @unique @db.VarChar(100)
  value           String           @db.Text
  valueType       SettingValueType @default(string) @map("value_type")
  description     String?          @db.Text
  updatedByUserId String?          @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  updatedByUser User? @relation("AppSettingUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("app_settings")
}

model Category {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId          String?  @map("parent_id") @db.Uuid
  scope             String   @db.VarChar(50)
  name              String   @db.VarChar(100)
  slug              String   @db.VarChar(100)
  description       String?  @db.Text
  iconUrl           String?  @map("icon_url") @db.VarChar(500)
  sortOrder         Int      @default(0) @map("sort_order")
  allowPostCreation Boolean  @default(true) @map("allow_post_creation")
  requiredRankId    String?  @map("required_rank_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  parent        Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]     @relation("CategoryHierarchy")
  requiredRank  MemberRank?    @relation(fields: [requiredRankId], references: [id])
  userInterests UserInterest[]
  // Phase 5
  events        Event[]
  // Phase 6
  projects      Project[]
  // Phase 7
  videos        Video[]
  // Phase 8
  skillListings SkillListing[]
  // Phase 9
  products      Product[]
  albums        Album[]

  @@unique([scope, slug])
  @@index([scope, sortOrder])
  @@index([requiredRankId])
  @@map("categories")
}

model Tag {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(50)
  slug       String   @unique @db.VarChar(50)
  usageCount Int      @default(0) @map("usage_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Phase 5
  eventTags   EventTag[]
  // Phase 6
  projectTags ProjectTag[]
  // Phase 9
  albumTags   AlbumTag[]

  @@map("tags")
}

model File {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedByUserId    String       @map("uploaded_by_user_id") @db.Uuid
  originalName        String       @map("original_name") @db.VarChar(255)
  storageKey          String       @unique @map("storage_key") @db.VarChar(500)
  storageBucket       String       @map("storage_bucket") @db.VarChar(100)
  contentType         String       @map("content_type") @db.VarChar(100)
  fileSizeBytes       BigInt       @map("file_size_bytes")
  fileCategory        FileCategory @default(general) @map("file_category")
  imageWidth          Int?         @map("image_width")
  imageHeight         Int?         @map("image_height")
  thumbnailStorageKey String?      @map("thumbnail_storage_key") @db.VarChar(500)
  checksumSha256      String?      @map("checksum_sha256") @db.VarChar(64)
  isPublic            Boolean      @default(false) @map("is_public")
  publicUrl           String?      @map("public_url") @db.VarChar(500)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz()

  // Relations
  uploadedByUser                User                           @relation(fields: [uploadedByUserId], references: [id])
  // Phase 3
  chatMessages                  ChatMessage[]
  broadcastAttachments          BroadcastAttachment[]
  // Phase 5
  eventFiles                    EventFile[]
  eventResultAttachments        EventResultAttachment[]
  // Phase 6
  projectFiles                  ProjectFile[]
  projectThreadReplyAttachments ProjectThreadReplyAttachment[]
  projectTaskAttachments        ProjectTaskAttachment[]
  // Phase 7
  videoAttachments              VideoAttachment[]
  videoTaskAttachments          VideoTaskAttachment[]
  // Phase 9
  productImages                 ProductImage[]
  albumPhotos                   AlbumPhoto[]
  venueImages                   VenueImage[]
  libraryItems                  UserLibraryItem[]
  // Phase 10
  memoAttachments               MemoAttachment[]

  @@index([uploadedByUserId])
  @@index([storageKey])
  @@index([createdAt(sort: Desc)])
  @@map("files")
}

model UserProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  avatarUrl         String?   @map("avatar_url") @db.VarChar(500)
  phone             String?   @db.VarChar(20)
  birthday          DateTime? @db.Date
  memberCardBarcode String?   @unique @map("member_card_barcode") @db.VarChar(100)
  nameKana          String?   @map("name_kana") @db.VarChar(100)
  gender            Gender?
  occupation        String?   @db.VarChar(100)
  countryOfOrigin   String?   @map("country_of_origin") @db.VarChar(100)
  headerImageUrl    String?   @map("header_image_url") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserInterest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@map("user_interests")
}

model UserLanguage {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  languageCode String               @map("language_code") @db.VarChar(10)
  proficiency  LanguageProficiency?
  sortOrder    Int                  @default(0) @map("sort_order")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode])
  @@map("user_languages")
}

model UserAffiliation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  organizationName String   @map("organization_name") @db.VarChar(200)
  title            String?  @db.VarChar(100)
  roleDescription  String?  @map("role_description") @db.VarChar(200)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@map("user_affiliations")
}

model UserPublicInfo {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  nickname       String?      @db.VarChar(100)
  nicknameKana   String?      @map("nickname_kana") @db.VarChar(100)
  specialty      String?      @db.VarChar(200)
  prefecture     String?      @db.VarChar(50)
  city           String?      @db.VarChar(100)
  foreignCountry String?      @map("foreign_country") @db.VarChar(100)
  foreignCity    String?      @map("foreign_city") @db.VarChar(100)
  introduction   String?      @db.Text
  eventRole      String?      @map("event_role") @db.VarChar(50)
  publicStatus   PublicStatus @default(private) @map("public_status")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([publicStatus])
  @@map("user_public_info")
}

// ============================================================
// Phase 2: 掲示板・通知
// ============================================================

// --- Enums ---

enum PublishStatus {
  draft
  published
  unpublished
}

// --- Models ---

model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String    @db.VarChar(30)
  title         String    @db.VarChar(200)
  body          String?   @db.Text
  referenceType String?   @map("reference_type") @db.VarChar(30)
  referenceId   String?   @map("reference_id") @db.Uuid
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  isRead        Boolean   @default(false) @map("is_read")
  readAt        DateTime? @map("read_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  notificationType String   @map("notification_type") @db.VarChar(30)
  emailEnabled     Boolean  @default(true) @map("email_enabled")
  inAppEnabled     Boolean  @default(true) @map("in_app_enabled")
  lineEnabled      Boolean  @default(false) @map("line_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@map("notification_preferences")
}

model BoardCategory {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String    @db.VarChar(100)
  description        String?   @db.Text
  sortOrder          Int       @default(0) @map("sort_order")
  allowTopicCreation Boolean   @default(true) @map("allow_topic_creation")
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz()

  // Relations
  createdByUser User         @relation(fields: [createdByUserId], references: [id])
  topics        BoardTopic[]

  @@index([sortOrder])
  @@map("board_categories")
}

model BoardLike {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("board_likes")
}

model BoardTopic {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  authorUserId  String        @map("author_user_id") @db.Uuid
  title         String        @db.VarChar(200)
  body          String        @db.Text
  publishStatus PublishStatus @default(published) @map("publish_status")
  isPinned      Boolean       @default(false) @map("is_pinned")
  sortOrder     Int           @default(0) @map("sort_order")
  viewCount     Int           @default(0) @map("view_count")
  postCount     Int           @default(0) @map("post_count")
  likeCount     Int           @default(0) @map("like_count")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz()

  // Relations
  category BoardCategory    @relation(fields: [categoryId], references: [id])
  author   User             @relation(fields: [authorUserId], references: [id])
  posts    BoardTopicPost[]

  @@index([categoryId, isPinned(sort: Desc), sortOrder, createdAt(sort: Desc)])
  @@index([authorUserId])
  @@map("board_topics")
}

model BoardTopicPost {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId      String    @map("topic_id") @db.Uuid
  authorUserId String    @map("author_user_id") @db.Uuid
  body         String    @db.Text
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  // Relations
  topic    BoardTopic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author   User                    @relation(fields: [authorUserId], references: [id])
  comments BoardTopicPostComment[]

  @@index([topicId, createdAt])
  @@index([authorUserId])
  @@map("board_topic_posts")
}

model BoardTopicPostComment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId          String    @map("post_id") @db.Uuid
  authorUserId    String    @map("author_user_id") @db.Uuid
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  body            String    @db.Text
  likeCount       Int       @default(0) @map("like_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  // Relations
  post          BoardTopicPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User                    @relation(fields: [authorUserId], references: [id])
  parentComment BoardTopicPostComment?  @relation("TopicPostCommentHierarchy", fields: [parentCommentId], references: [id])
  childComments BoardTopicPostComment[] @relation("TopicPostCommentHierarchy")

  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([authorUserId])
  @@map("board_topic_post_comments")
}

// ============================================================
// Phase 3: チャット・メール配信
// ============================================================

// --- Enums ---

enum ChatRoomType {
  dm
  group
}

enum ChatRoomMemberRole {
  admin
  member
}

enum ChatMessageType {
  text
  image
  file
}

enum BroadcastTargetType {
  all
  rank
  custom
  event
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  sent
  failed
}

enum BroadcastRecipientStatus {
  pending
  sent
  delivered
  bounced
  opened
  clicked
  failed
}

enum BroadcastSuppressionReason {
  unsubscribe
  bounce
  complaint
  manual
}

enum BroadcastTemplateCategory {
  event
  general
}

enum BroadcastChannel {
  in_app
  email
  line
}

enum BroadcastScope {
  global
  event
}

// --- Models ---

model ChatRoom {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            ChatRoomType @default(dm)
  name            String?      @db.VarChar(100)
  description     String?      @db.Text
  iconUrl         String?      @map("icon_url") @db.VarChar(500)
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  maxMembers      Int?         @map("max_members")
  lastMessageAt   DateTime?    @map("last_message_at") @db.Timestamptz()
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  createdByUser User?            @relation("ChatRoomCreator", fields: [createdByUserId], references: [id])
  members       ChatRoomMember[]
  messages      ChatMessage[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([type])
  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatRoomId String             @map("chat_room_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  role       ChatRoomMemberRole @default(member)
  lastReadAt DateTime?          @map("last_read_at") @db.Timestamptz()
  isMuted    Boolean            @default(false) @map("is_muted")
  joinedAt   DateTime           @default(now()) @map("joined_at") @db.Timestamptz()
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([userId])
  @@map("chat_room_members")
}

model ChatMessage {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatRoomId   String          @map("chat_room_id") @db.Uuid
  senderUserId String          @map("sender_user_id") @db.Uuid
  messageType  ChatMessageType @default(text) @map("message_type")
  body         String?         @db.Text
  fileId       String?         @map("file_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz()

  // Relations
  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation("ChatMessageSender", fields: [senderUserId], references: [id])
  file     File?    @relation(fields: [fileId], references: [id])

  @@index([chatRoomId, createdAt(sort: Desc)])
  @@index([senderUserId])
  @@map("chat_messages")
}

model Broadcast {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject         String              @db.VarChar(200)
  bodyHtml        String              @map("body_html") @db.Text
  bodyText        String?             @map("body_text") @db.Text
  scope           BroadcastScope      @default(global)
  channels        BroadcastChannel[]  @default([email])
  targetType      BroadcastTargetType @map("target_type")
  targetFilter    Json?               @map("target_filter") @db.JsonB
  templateId      String?             @map("template_id") @db.Uuid
  status          BroadcastStatus     @default(draft)
  scheduledAt     DateTime?           @map("scheduled_at") @db.Timestamptz()
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz()
  totalRecipients Int                 @default(0) @map("total_recipients")
  sentCount       Int                 @default(0) @map("sent_count")
  deliveredCount  Int                 @default(0) @map("delivered_count")
  failedCount     Int                 @default(0) @map("failed_count")
  lineSentCount   Int                 @default(0) @map("line_sent_count")
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  createdByUser User                  @relation("BroadcastCreator", fields: [createdByUserId], references: [id])
  template      BroadcastTemplate?    @relation(fields: [templateId], references: [id])
  recipients    BroadcastRecipient[]
  attachments   BroadcastAttachment[]

  @@index([status, createdAt(sort: Desc)])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  broadcastId String                   @map("broadcast_id") @db.Uuid
  userId      String                   @map("user_id") @db.Uuid
  channel     BroadcastChannel         @default(email)
  email       String                   @db.VarChar(255)
  status      BroadcastRecipientStatus @default(pending)
  sentAt      DateTime?                @map("sent_at") @db.Timestamptz()
  openedAt    DateTime?                @map("opened_at") @db.Timestamptz()
  clickedAt   DateTime?                @map("clicked_at") @db.Timestamptz()
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation("BroadcastRecipientUser", fields: [userId], references: [id])

  @@unique([broadcastId, userId, channel])
  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

model BroadcastAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  broadcastId String   @map("broadcast_id") @db.Uuid
  fileId      String   @map("file_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  file      File      @relation(fields: [fileId], references: [id])

  @@index([broadcastId, sortOrder])
  @@map("broadcast_attachments")
}

model BroadcastSuppression {
  id        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String                     @unique @db.VarChar(255)
  reason    BroadcastSuppressionReason
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz()

  @@map("broadcast_suppressions")
}

model BroadcastTemplate {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String                    @db.VarChar(100)
  category           BroadcastTemplateCategory
  subjectTemplate    String                    @map("subject_template") @db.VarChar(200)
  bodyHtmlTemplate   String                    @map("body_html_template") @db.Text
  bodyTextTemplate   String?                   @map("body_text_template") @db.Text
  availableVariables Json?                     @map("available_variables") @db.JsonB
  sortOrder          Int                       @default(0) @map("sort_order")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  broadcasts Broadcast[]

  @@index([category, sortOrder])
  @@map("broadcast_templates")
}

// ============================================================
// Phase 4: メンバー管理完成
// ============================================================

// --- Enums ---

enum AttributeType {
  text
  number
  date
  select
  multi_select
}

// --- Models ---

model MemberAttribute {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String        @db.VarChar(100)
  slug           String        @unique @db.VarChar(100)
  type           AttributeType
  options        Json?         @db.JsonB
  isRequired     Boolean       @default(false) @map("is_required")
  isSelfEditable Boolean       @default(false) @map("is_self_editable")
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  values MemberAttributeValue[]

  @@index([sortOrder])
  @@map("member_attributes")
}

model MemberAttributeValue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attribute MemberAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([userId, attributeId])
  @@index([attributeId])
  @@map("member_attribute_values")
}

// ============================================================
// Phase 5: イベント
// ============================================================

// --- Enums ---

enum EventLocationType {
  venue
  online
  hybrid
}

enum EventStatus {
  draft
  recruiting
  closed
  canceled
  ended
}

enum EventOrganizationRole {
  organizer
  co_organizer
  cooperation
  sponsor
  support
}

enum ParticipantStatus {
  applied
  confirmed
  canceled
  attended
  no_show
}

enum PaymentStatus {
  pending
  paid
  canceled
}

enum FormFieldVisibility {
  hidden
  optional
  required

  @@map("form_field_visibility")
}

enum ApplicationQuestionType {
  text
  textarea
  radio
  checkbox
  select

  @@map("application_question_type")
}

enum EventResultStatus {
  draft
  completed
}

enum EventExecutionStatus {
  as_planned
  modified
  partially_held
  postponed
  canceled

  @@map("event_execution_status")
}

// --- Models ---

model Event {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String            @db.VarChar(200)
  description              String?           @db.Text
  locationType             EventLocationType @default(venue) @map("location_type")
  venueId                  String?           @map("venue_id") @db.Uuid
  venueName                String?           @map("venue_name") @db.VarChar(300)
  venueAddress             String?           @map("venue_address") @db.VarChar(500)
  onlineUrl                String?           @map("online_url") @db.VarChar(500)
  startAt                  DateTime          @map("start_at") @db.Timestamptz()
  endAt                    DateTime          @map("end_at") @db.Timestamptz()
  registrationDeadlineAt   DateTime?         @map("registration_deadline_at") @db.Timestamptz()
  ticketSaleStartAt        DateTime?         @map("ticket_sale_start_at") @db.Timestamptz()
  allowMultiTicketPurchase Boolean           @default(false) @map("allow_multi_ticket_purchase")
  acceptedPaymentMethods   Json?             @map("accepted_payment_methods") @db.JsonB
  planningRole             String            @default("主催") @map("planning_role") @db.VarChar(30)
  eventType                String?           @map("event_type") @db.VarChar(30)
  categoryId               String?           @map("category_id") @db.Uuid
  accessInfo               String?           @map("access_info") @db.Text
  participationMethod      String?           @map("participation_method") @db.Text
  contactInfo              String?           @map("contact_info") @db.Text
  cancellationPolicy       String?           @map("cancellation_policy") @db.Text
  language                 String?           @default("ja") @db.VarChar(20)
  isAttendeeVisible        Boolean           @default(false) @map("is_attendee_visible")
  status                   EventStatus       @default(draft)
  coverImageUrl            String?           @map("cover_image_url") @db.VarChar(500)
  createdByUserId          String            @map("created_by_user_id") @db.Uuid
  requiredRankId           String?           @map("required_rank_id") @db.Uuid
  participantCount         Int               @default(0) @map("participant_count")
  isCalendarVisible        Boolean           @default(true) @map("is_calendar_visible")
  /// 検索用のタグ名連結。サービス層でタグ変更時に同期更新する非正規化カラム。pgroonga インデックス対象。
  tagsText                 String            @default("") @map("tags_text") @db.Text
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt                DateTime?         @map("deleted_at") @db.Timestamptz()

  // Relations
  createdByUser         User                        @relation("EventCreator", fields: [createdByUserId], references: [id])
  category              Category?                   @relation(fields: [categoryId], references: [id])
  requiredRank          MemberRank?                 @relation(fields: [requiredRankId], references: [id])
  venue                 Venue?                      @relation(fields: [venueId], references: [id])
  tickets               EventTicket[]
  participants          EventParticipant[]
  speakers              EventSpeaker[]
  organizations         EventOrganization[]
  tags                  EventTag[]
  boardCategories       EventBoardCategory[]
  boardTopics           EventBoardTopic[]
  files                 EventFile[]
  result                EventResult?
  // Phase 6
  projects              Project[]
  // Phase 8
  surveys               Survey[]
  // 申込フォーム
  applicationFormConfig EventApplicationFormConfig?
  applicationQuestions  EventApplicationQuestion[]

  @@index([status, startAt])
  @@index([startAt])
  @@index([createdByUserId])
  @@index([categoryId])
  @@index([venueId])
  @@map("events")
}

model EventTicket {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  ticketName    String   @map("ticket_name") @db.VarChar(100)
  price         Int      @default(0)
  currency      String   @default("JPY") @db.VarChar(3)
  capacity      Int?
  purchaseLimit Int      @default(1) @map("purchase_limit")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  soldCount     Int      @default(0) @map("sold_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants  EventParticipant[]
  discountCodes EventDiscountCode[]

  @@index([eventId, sortOrder])
  @@map("event_tickets")
}

model EventParticipant {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  ticketId       String            @map("ticket_id") @db.Uuid
  quantity       Int               @default(1)
  status         ParticipantStatus @default(applied)
  paymentStatus  PaymentStatus?    @map("payment_status")
  paymentMethod  String?           @map("payment_method") @db.VarChar(30)
  discountCodeId String?           @map("discount_code_id") @db.Uuid

  applicantEmail       String  @map("applicant_email") @db.VarChar(255)
  applicantName        String? @map("applicant_name") @db.VarChar(100)
  applicantNameKana    String? @map("applicant_name_kana") @db.VarChar(100)
  applicantAffiliation String? @map("applicant_affiliation") @db.VarChar(200)
  applicantGender      Gender? @map("applicant_gender")
  applicantAge         Int?    @map("applicant_age")
  applicantOccupation  String? @map("applicant_occupation") @db.VarChar(100)
  applicantNationality String? @map("applicant_nationality") @db.VarChar(100)

  appliedAt  DateTime  @default(now()) @map("applied_at") @db.Timestamptz()
  canceledAt DateTime? @map("canceled_at") @db.Timestamptz()
  attendedAt DateTime? @map("attended_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  event        Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id])
  ticket       EventTicket              @relation(fields: [ticketId], references: [id])
  discountCode EventDiscountCode?       @relation(fields: [discountCodeId], references: [id])
  answers      EventParticipantAnswer[]

  @@unique([eventId, userId, ticketId])
  @@index([userId])
  @@index([eventId, status])
  @@map("event_participants")
}

model EventApplicationFormConfig {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid

  notifyOnCapacityReached    Boolean @default(false) @map("notify_on_capacity_reached")
  notifyOnRemainingThreshold Int?    @map("notify_on_remaining_threshold")

  completionMessageApp   String? @map("completion_message_app") @db.Text
  completionMessageEmail String? @map("completion_message_email") @db.Text

  askName        FormFieldVisibility @default(required) @map("ask_name")
  askNameKana    FormFieldVisibility @default(hidden) @map("ask_name_kana")
  askAffiliation FormFieldVisibility @default(hidden) @map("ask_affiliation")
  askGender      FormFieldVisibility @default(hidden) @map("ask_gender")
  askAge         FormFieldVisibility @default(hidden) @map("ask_age")
  askOccupation  FormFieldVisibility @default(hidden) @map("ask_occupation")
  askNationality FormFieldVisibility @default(hidden) @map("ask_nationality")

  reminderEnabled     Boolean @default(false) @map("reminder_enabled")
  reminderHoursBefore Int     @default(24) @map("reminder_hours_before")
  reminderMessage     String? @map("reminder_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_application_form_configs")
}

model EventApplicationQuestion {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String                  @map("event_id") @db.Uuid
  label        String                  @db.VarChar(200)
  description  String?                 @db.Text
  questionType ApplicationQuestionType @map("question_type")
  options      Json?
  isRequired   Boolean                 @default(false) @map("is_required")
  sortOrder    Int                     @default(0) @map("sort_order")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz()

  event   Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers EventParticipantAnswer[]

  @@index([eventId, sortOrder])
  @@map("event_application_questions")
}

model EventParticipantAnswer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  questionId    String   @map("question_id") @db.Uuid
  answer        Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  participant EventParticipant         @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question    EventApplicationQuestion @relation(fields: [questionId], references: [id])

  @@unique([participantId, questionId])
  @@index([questionId])
  @@map("event_participant_answers")
}

model EventSpeaker {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  title     String?  @db.VarChar(100)
  role      String   @db.VarChar(30)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([eventId, sortOrder])
  @@map("event_speakers")
}

model EventOrganization {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String                @map("event_id") @db.Uuid
  organizationName String                @map("organization_name") @db.VarChar(200)
  role             EventOrganizationRole
  sortOrder        Int                   @default(0) @map("sort_order")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_organizations")
}

model EventTag {
  eventId String @map("event_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([tagId])
  @@map("event_tags")
}

model EventBoardCategory {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String    @map("event_id") @db.Uuid
  name               String    @db.VarChar(100)
  description        String?   @db.Text
  sortOrder          Int       @default(0) @map("sort_order")
  allowTopicCreation Boolean   @default(true) @map("allow_topic_creation")
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
