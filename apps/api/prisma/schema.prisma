  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  memo Memo @relation(fields: [memoId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id])

  @@index([memoId, sortOrder])
  @@index([fileId])
  @@map("memo_attachments")
}

// --- カレンダー ---

model Schedule {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  sourceType  ScheduleSourceType? @map("source_type")
  sourceId    String?             @map("source_id") @db.Uuid
  title       String              @db.VarChar(200)
  description String?             @db.Text
  startAt     DateTime            @map("start_at") @db.Timestamptz()
  endAt       DateTime            @map("end_at") @db.Timestamptz()
  isAllDay    Boolean             @default(false) @map("is_all_day")
  location    String?             @db.VarChar(300)
  visibility  ScheduleVisibility  @default(private)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, sourceType, sourceId])
  @@index([userId, startAt, endAt])
  @@index([sourceType])
  @@map("schedules")
}

// --- モデレーション ---

model ContentReport {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterUserId   String           @map("reporter_user_id") @db.Uuid
  targetType       ReportTargetType @map("target_type")
  targetId         String           @map("target_id") @db.Uuid
  category         ReportCategory
  description      String?          @db.Text
  status           ReportStatus     @default(pending)
  assignedToUserId String?          @map("assigned_to_user_id") @db.Uuid
  resolvedAt       DateTime?        @map("resolved_at") @db.Timestamptz()
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  reporter   User               @relation("ReportReporter", fields: [reporterUserId], references: [id])
  assignedTo User?              @relation("ReportAssignee", fields: [assignedToUserId], references: [id])
  actions    ModerationAction[]

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("content_reports")
}

model ModerationAction {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId        String?              @map("report_id") @db.Uuid
  moderatorUserId String               @map("moderator_user_id") @db.Uuid
  actionType      ModerationActionType @map("action_type")
  targetType      String               @map("target_type") @db.VarChar(30)
  targetId        String               @map("target_id") @db.Uuid
  reason          String?              @db.Text
  notes           String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  report    ContentReport? @relation(fields: [reportId], references: [id])
  moderator User           @relation("ModerationActor", fields: [moderatorUserId], references: [id])

  @@index([reportId])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@map("moderation_actions")
}

model BannedWord {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  word        String              @db.VarChar(100)
  matchType   BannedWordMatchType @default(exact) @map("match_type")
  action      BannedWordAction    @default(flag)
  replacement String?             @db.VarChar(100)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("banned_words")
}

