model Survey {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String           @db.VarChar(200)
  description     String?          @db.Text
  eventId         String?          @map("event_id") @db.Uuid
  isTemplate      Boolean          @default(false) @map("is_template")
  templateId      String?          @map("template_id") @db.Uuid
  isAnonymous     Boolean          @default(false) @map("is_anonymous")
  status          SurveyStatus     @default(draft)
  targetType      SurveyTargetType @default(all) @map("target_type")
  targetFilter    Json?            @map("target_filter") @db.JsonB
  startsAt        DateTime?        @map("starts_at") @db.Timestamptz()
  endsAt          DateTime?        @map("ends_at") @db.Timestamptz()
  responseCount   Int              @default(0) @map("response_count")
  notifiedAt      DateTime?        @map("notified_at") @db.Timestamptz()
  remindedAt      DateTime?        @map("reminded_at") @db.Timestamptz()
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()

  // Relations
  createdBy User             @relation("SurveyCreator", fields: [createdByUserId], references: [id])
  event     Event?           @relation(fields: [eventId], references: [id])
