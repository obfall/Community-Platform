{
  "name": "community-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "generate-feature-list": "node scripts/generate-feature-list.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "db:seed:demo": "pnpm --filter @community-platform/api db:seed:demo",
    "db:reset:demo": "pnpm --filter @community-platform/api db:reset:demo",
    "e2e": "pnpm --filter @community-platform/web e2e",
    "e2e:ui": "pnpm --filter @community-platform/web e2e:ui",
    "e2e:report": "pnpm --filter @community-platform/web e2e:report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0"
  },
  "pnpm": {
    "overrides": {
      "file-type@<21.3.2": "^21.3.2",
      "follow-redirects@<1.16.0": "^1.16.0",
      "uuid@<14.0.0": "^14.0.0",
      "postcss@<8.5.10": "^8.5.10",
      "defu@<6.1.5": "^6.1.5",
      "node-emoji@<2.0.0": "^2.2.0",
      "eslint-plugin-react-hooks": "7.0.1",
      "fast-uri@<3.1.2": "^3.1.2",
      "fast-xml-builder@<1.1.7": "^1.1.7"
    }
  }
}
